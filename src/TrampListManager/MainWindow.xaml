<Window x:Class="TrampListManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrampList Manager" Height="640" Width="880"
        MinHeight="500" MinWidth="700"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        TextElement.Foreground="{StaticResource Foreground}"
        FontFamily="Segoe UI"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Card}" Padding="20,15"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="TRAMPLIST MANAGER" FontFamily="Consolas" FontSize="16"
                               FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                    <TextBlock Text="Install and share Trampler designs"
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="Open TrampList" Click="OnOpenSite" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Style="{StaticResource GhostButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardSoft}" Padding="20,14"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="INSTALL A DESIGN" FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SlugInput" Grid.Column="0"
                             Style="{StaticResource Field}"
                             KeyDown="OnSlugKeyDown"
                             Tag="Paste a design ID or link  —  e.g. test-8bed65"/>

                    <Button x:Name="InstallButton" Grid.Column="1" Content="Install"
                            Click="OnInstallSlug"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>

                    <Button Grid.Column="2" Content="Choose file…" Click="OnInstallFile"
                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock Text="…or drop a .wbt file anywhere on this window."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="CountLabel" Text="YOUR TRAMPLERS" FontFamily="Consolas"
                           FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back up folder" Click="OnBackup" Style="{StaticResource GhostButton}"/>
                    <Button Content="Open folder" Click="OnOpenFolder" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/>
                    <Button Content="Refresh" Click="OnRefresh" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <ListView x:Name="WalkerList" Style="{StaticResource ListStyle}"
                              SelectionChanged="OnSelectionChanged"
                              MouseDoubleClick="OnShare">
                        <ListView.View>
                            <GridView>
                                <!-- Name and chassis carry the row; the raw ID is demoted
                                     to a tooltip since it identifies nothing to a human. -->
                                <GridViewColumn Header="Design" Width="230">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ShortId}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Chassis / crew" Width="290">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Source" Width="95"
                                                DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="Size" Width="80"
                                                DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Last saved" Width="115"
                                                DisplayMemberBinding="{Binding ModifiedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="EmptyLabel" Visibility="Collapsed"
                               Foreground="{StaticResource Muted}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="20,12" Margin="0,16,0,0"
                Background="{StaticResource Card}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,320,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenPageButton" Content="View on TrampList" Click="OnOpenDesignPage"
                            Style="{StaticResource GhostButton}" IsEnabled="False"/>
                    <Button x:Name="RenameButton" Content="Rename" Click="OnRename"
                            Style="{StaticResource GhostButton}" IsEnabled="False" Margin="6,0,0,0"/>
                    <Button x:Name="ShareButton" Content="Share this design…" Click="OnShare"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="6,0,0,0"/>
                    <Button x:Name="AssocButton" Content="File association" Click="OnToggleAssociation"
                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
