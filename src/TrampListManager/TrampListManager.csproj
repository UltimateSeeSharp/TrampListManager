<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- The .exe icon, used by Explorer, the taskbar and Alt+Tab. Also the icon the
         shell shows for .wbt files once the association is registered, since
         ShellIntegration points DefaultIcon at this executable. -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <AssemblyTitle>TrampList Manager</AssemblyTitle>
    <Product>TrampList Manager</Product>
    <Description>Install and share Trampler designs for SAND: Raiders of Sophie.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the window can show it in its title bar. -->
    <Resource Include="app.ico" />

    <!-- Oswald and Inter, matching the site. These must be <Resource> rather than
         Content: a pack:// FontFamily URI resolves against embedded resources, and a
         missing one fails silently by falling back to Arial. tests/Verify checks that
         the families actually resolve, because nothing else would notice. -->
    <Resource Include="Fonts\Oswald.ttf" />
    <Resource Include="Fonts\Inter.ttf" />
  </ItemGroup>

</Project>
