<Window x:Class="TrampListManager.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label this Trampler" Height="248" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Background}"
        TextElement.Foreground="{StaticResource Foreground}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Give this design a name you'll recognise."
                   FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Stored on your PC only — the game doesn't keep names in the file."
                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <TextBlock Text="Name" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="80"/>

        <TextBlock Text="Notes (optional)" FontSize="11" Foreground="{StaticResource Muted}"
                   Margin="0,12,0,4"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource Field}" MaxLength="120"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="OnCancel" Style="{StaticResource GhostButton}"/>
            <Button Content="Save" Click="OnSave" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
