<Application x:Class="TrampListManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        No StartupUri: the window is created in code, because startup depends on how the
        app was launched (browse, a .wbt file, or a tramplist:// link).

        The palette and type live in Theme.xaml so they can be loaded and checked on
        their own, without constructing an Application.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
